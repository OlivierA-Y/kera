# Copy to web/.env and set your server-side key. Never put this key in dist/.
OPENROUTER_API_KEY=
# Override with another OpenRouter model supporting image input and JSON-schema output.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# Set true only if you accept provider logging/training (required by some free endpoints).
OPENROUTER_ALLOW_DATA_COLLECTION=false
PORT=4173
# Loopback only. This server is for local use, not public hosting.
HOST=127.0.0.1
