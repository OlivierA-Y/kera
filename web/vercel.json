{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/vision/status", "destination": "/api/index?endpoint=status" },
    { "source": "/api/vision/analyze", "destination": "/api/index?endpoint=analyze" },
    { "source": "/api/scans/average", "destination": "/api/index?endpoint=average" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
    ] }
  ]
}
